# Copia este archivo a `.env` y completa tus valores.
# El archivo `.env` esta en .gitignore y NUNCA debe subirse al repositorio.

# Credenciales de Google para login automatico (opcional; si no se definen,
# auth_setup.py espera login manual en el navegador).
GOOGLE_EMAIL=tu_email@gmail.com
GOOGLE_PASSWORD=tu_password

# URL de Redis. Por defecto localhost en local; dentro de docker-compose usa "redis".
REDIS_URL=redis://localhost:6379/0

# Reintentos de autenticacion (opcional)
AUTH_MAX_RETRIES=3
AUTH_RETRY_DELAY_SECONDS=60
AUTH_TIMEOUT_SELECTOR=30000
AUTH_TIMEOUT_NAVIGATION=60000
