{
  "_comment": "Enhanced selectors with primary, fallbacks, and validators for robust element detection",
  "new_chat_button": {
    "primary": "button[data-test-id='expanded-button']",
    "fallbacks": [
      "role=button[name*='New chat' i]",
      "role=button[name*='Nueva conversación' i]",
      "mat-icon[data-mat-icon-name='edit_square']",
      "button:has-text('New chat')",
      "button:has-text('Nueva conversación')",
      "[aria-label*='New chat' i]",
      "button:has(mat-icon[data-mat-icon-name='edit_square'])"
    ],
    "validator": "rich-textarea .ql-editor.ql-blank"
  },
  "prompt_textarea": {
    "primary": "rich-textarea .ql-editor[contenteditable='true'][role='textbox']",
    "fallbacks": [
      "role=textbox[name*='prompt' i]",
      "role=textbox[name*='petición' i]",
      ".ql-editor[contenteditable='true']",
      "[role='textbox'][contenteditable='true']",
      "rich-textarea .ql-editor"
    ]
  },
  "tools_button": {
    "primary": "button:has-text('Herramientas')",
    "fallbacks": [
      "button:has-text('Tools')",
      "role=button[name*='Herramientas' i]",
      "role=button[name*='Tools' i]",
      "[aria-label*='Herramientas' i]",
      "[aria-label*='Tools' i]",
      "mat-icon[data-mat-icon-name='page_info']",
      "button:has(mat-icon[data-mat-icon-name='page_info'])",
      "mat-icon[data-mat-icon-name='extension']",
      "button:has(mat-icon[data-mat-icon-name='extension'])",
      "mat-icon[data-mat-icon-name='tune']",
      "button:has(mat-icon[data-mat-icon-name='tune'])",
      "[aria-label*='Extension' i]",
      "[aria-label*='Complementos' i]"
    ]
  },
  "mode_selector": {
    "primary": "button:has-text('Razonamiento')",
    "fallbacks": [
      "role=button[name*='Gemini']",
      "button:has-text('Gemini')",
      ".mode-selector",
      "div.logo-pill-label-container",
      "[role='button']:has-text('Gemini')",
      "div:has(mat-icon[data-mat-icon-name='keyboard_arrow_down'])"
    ],
    "dropdown_icon": "mat-icon[data-mat-icon-name='keyboard_arrow_down']",
    "reasoning_option": "menuitem:has-text('Razonamiento')",
    "validator": "button:has-text('Razonamiento')"
  },
  "canvas_button": {
    "primary": "button.toolbox-drawer-item-list-button mat-icon[data-mat-icon-name='note_stack_add']",
    "fallbacks": [
      "role=button[name*='Canvas' i]",
      "button:has-text('Canvas')",
      "mat-icon[data-mat-icon-name='note_stack_add']:visible",
      "[aria-label*='Canvas' i]",
      "button:has(mat-icon[data-mat-icon-name='note_stack_add'])",
      "button:has(mat-icon[data-mat-icon-name='description'])",
      "mat-icon[data-mat-icon-name='description']"
    ],
    "validator": "button.toolbox-drawer-item-deselect-button:has-text('Canvas'), toolbox-drawer button:has-text('Canvas'), .pill-container button:has-text('Canvas')"
  },
  "deep_research_button": {
    "primary": "[role='group'] button:has-text('Deep Research')",
    "fallbacks": [
      "role=button[name*='Deep Research' i]",
      "role=button[name*='Investigación profunda' i]",
      "button:has-text('Deep Research')",
      "button:has-text('Investigación profunda')",
      "mat-icon[data-mat-icon-name='research']:visible",
      "[aria-label*='Deep Research' i]",
      "[aria-label*='Investigación profunda' i]"
    ],
    "validator": "button.toolbox-drawer-item-deselect-button:has-text('Deep Research'), button.toolbox-drawer-item-deselect-button:has-text('Investigación profunda'), toolbox-drawer button:has-text('Deep Research'), toolbox-drawer button:has-text('Investigación profunda')"
  },
  "canvas_content": {
    "primary": "div.canvas-editor-content",
    "fallbacks": [
      "role=textbox[name*='Canvas' i]",
      "text-editor .ql-editor",
      "[data-test-id='canvas-editor']",
      ".canvas-host-content",
      "div[role='textbox'][contenteditable='true']:visible"
    ]
  },
  "deep_research_content": {
    "primary": "div.deep-research-report",
    "fallbacks": [
      "role=article[name*='Research' i]",
      ".research-report-content",
      "[data-test-id='research-report']"
    ]
  },
  "deep_research_confirm_button": {
    "primary": "button[data-test-id='confirm-button']",
    "fallbacks": [
      "role=button[name*='Confirm' i]",
      "role=button[name*='Confirmar' i]",
      "button:has-text('Confirm')",
      "button:has-text('Confirmar')",
      "[role='button']:has-text('Confirm')",
      "[role='button']:has-text('Confirmar')"
    ]
  },
  "deep_research_plan_ready": {
    "primary": "button[data-test-id='confirm-button']",
    "fallbacks": [
      "role=button[name*='Confirm' i]",
      "role=button[name*='Confirmar' i]",
      "button:has-text('Confirm')",
      "button:has-text('Confirmar')"
    ]
  },
  "mic_button": {
    "primary": "mat-icon[data-mat-icon-name='mic']",
    "fallbacks": [
      "role=button[name*='mic' i]",
      "role=button[name*='micro' i]",
      "role=button[name*='dictar' i]",
      "[aria-label*='mic' i]",
      "[aria-label*='micro' i]",
      "mat-icon[data-mat-icon-name='google_mic']"
    ]
  },
  "send_button": {
    "primary": "mat-icon[data-mat-icon-name='send']",
    "fallbacks": [
      "role=button[name*='Send' i]",
      "role=button[name*='Enviar' i]",
      "button:has(mat-icon[data-mat-icon-name='send'])",
      "[aria-label*='Send' i]",
      "[aria-label*='Enviar' i]",
      "button[type='submit']"
    ]
  },
  "stop_button": {
    "primary": "button[aria-label*='Stop' i]",
    "fallbacks": [
      "role=button[name*='Stop' i]",
      "role=button[name*='Detener' i]",
      "button:has(mat-icon[data-mat-icon-name='stop_circle'])",
      "mat-icon[data-mat-icon-name='stop_circle']",
      "[aria-label*='Detener' i]",
      "button:has-text('Stop generating')"
    ]
  },
  "last_response": {
    "primary": ".model-response-text",
    "fallbacks": [
      "role=log",
      ".response-container",
      "[data-test-id='model-response']",
      ".message-content",
      ".response-text"
    ]
  },
  "show_more": {
    "primary": "button:has-text('Submit')",
    "fallbacks": [
      "button:has-text('Show more')",
      "button:has-text('Mostrar más')",
      "button:has-text('Show more drafts')",
      "button:has-text('View details')"
    ]
  }
}